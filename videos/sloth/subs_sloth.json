[
 {
  "text": "刷到这条，你抽中的是——",
  "t0": 0.1,
  "t1": 4.306,
  "minD": 2.87
 },
 {
  "text": "你不是懒。",
  "t0": 4.366,
  "t1": 6.476,
  "minD": 1.68
 },
 {
  "text": "是你的大脑，把“明天的你”当成了陌生人。",
  "t0": 6.536,
  "t1": 10.814,
  "minD": 3.72
 },
 {
  "text": "研究发现：想到“十年后的自己”，大脑的反应像在想陌生人。",
  "t0": 10.874,
  "t1": 16.237,
  "minD": 4.91
 },
 {
  "text": "所以把事情推给明天，就像推给了别人。",
  "t0": 16.297,
  "t1": 20.033,
  "minD": 3.72
 },
 {
  "text": "大脑只占体重的2%，却耗掉约两成能量。",
  "t0": 20.093,
  "t1": 24.372,
  "minD": 3.89
 },
 {
  "text": "所以它天生想省力，能躺就不想动。",
  "t0": 24.431,
  "t1": 28.168,
  "minD": 3.38
 },
 {
  "text": "研究发现：拖延，常常不是时间问题，",
  "t0": 28.228,
  "t1": 31.964,
  "minD": 3.38
 },
 {
  "text": "而是在躲开一种难受的感觉。",
  "t0": 32.024,
  "t1": 35.218,
  "minD": 3.04
 },
 {
  "text": "先不碰它，心里就能舒服一会儿。",
  "t0": 35.278,
  "t1": 38.471,
  "minD": 3.21
 },
 {
  "text": "所以那个总说“明天再说”的你——",
  "t0": 38.531,
  "t1": 41.725,
  "minD": 3.04
 },
 {
  "text": "不是懒，只是还没准备好面对它。",
  "t0": 41.785,
  "t1": 44.979,
  "minD": 3.21
 },
 {
  "text": "你最近在拖的那件事，是什么？",
  "t0": 45.039,
  "t1": 48.233,
  "minD": 3.04
 },
 {
  "text": "下一集：贪婪",
  "t0": 48.293,
  "t1": 50.15,
  "minD": 1.85
 }
]