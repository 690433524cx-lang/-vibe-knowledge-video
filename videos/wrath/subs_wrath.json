[
 {
  "text": "你吼得最凶的那个人，",
  "t0": 0.2,
  "t1": 4.306,
  "minD": 2.53
 },
 {
  "text": "往往不是陌生人，而是你最亲的人。",
  "t0": 4.366,
  "t1": 8.102,
  "minD": 3.38
 },
 {
  "text": "调查发现：大多数人生气的对象，是家人、伴侣和朋友。",
  "t0": 8.162,
  "t1": 12.983,
  "minD": 4.57
 },
 {
  "text": "陌生人？反而很少。",
  "t0": 13.043,
  "t1": 15.695,
  "minD": 2.19
 },
 {
  "text": "因为愤怒，比理智快一步。",
  "t0": 15.755,
  "t1": 18.406,
  "minD": 2.7
 },
 {
  "text": "危险信号会走一条近路，先到杏仁核；",
  "t0": 18.466,
  "t1": 22.202,
  "minD": 3.55
 },
 {
  "text": "绕远路的理智，还在半路上。",
  "t0": 22.262,
  "t1": 25.456,
  "minD": 2.87
 },
 {
  "text": "生气时，手指温度会升高：血液正涌向你的手。",
  "t0": 25.516,
  "t1": 29.795,
  "minD": 4.06
 },
 {
  "text": "那打沙袋、摔东西，能把火发出去吗？",
  "t0": 29.855,
  "t1": 33.591,
  "minD": 3.38
 },
 {
  "text": "2002年的一项实验：边想着惹你的人边打沙袋——",
  "t0": 33.651,
  "t1": 38.471,
  "minD": 4.57
 },
 {
  "text": "火反而更大；安静坐着的那组，最先平静下来。",
  "t0": 38.531,
  "t1": 42.81,
  "minD": 4.06
 },
 {
  "text": "愤怒下面，常常压着委屈、害怕或失望。",
  "t0": 42.87,
  "t1": 46.606,
  "minD": 3.55
 },
 {
  "text": "所以你最生气的那个人——",
  "t0": 46.666,
  "t1": 49.317,
  "minD": 2.7
 },
 {
  "text": "也许正是你最怕失去的人。",
  "t0": 49.377,
  "t1": 52.571,
  "minD": 2.87
 },
 {
  "text": "你上一次发火，是对谁？",
  "t0": 52.631,
  "t1": 55.631,
  "minD": 3
 }
]